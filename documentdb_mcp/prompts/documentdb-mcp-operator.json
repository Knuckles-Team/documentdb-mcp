      "documentdb_drop_user",
      "documentdb_find",
      "documentdb_find_one",
      "documentdb_find_one_and_delete",
      "documentdb_find_one_and_replace",
      "documentdb_find_one_and_update",
      "documentdb_ingest_catalog",
      "documentdb_ingest_documents",
      "documentdb_insert_many",
      "documentdb_insert_one",
      "documentdb_list_collections",
      "documentdb_list_databases",
      "documentdb_rename_collection",
      "documentdb_replace_one",
      "documentdb_run_command",
      "documentdb_update_many",
