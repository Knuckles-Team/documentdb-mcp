        "documentdb_drop_user",
        "documentdb_find_one_and_delete",
        "documentdb_run_command"
      ],
      "never": [
        "Delete or drop without explicit approval.",
        "Run a raw command when a typed tool covers it.",
        "Expose a password or connection URI."
      ]
    },
    "outputs": [
      "A summary of each action with its counts or ids."
    ]
  }
